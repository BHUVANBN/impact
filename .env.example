CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional: public URL Cloudinary can reach (e.g. ngrok) -> https://<host>/api/webhooks/cloudinary
CLOUDINARY_NOTIFICATION_URL=
# Optional, only if your plan has a tagging add-on, e.g. google_tagging:0.6
CLOUDINARY_AUTO_TAGGING=
# Vision/LLM (Anthropic). Enables image analysis, pair verification, grounded Q&A and report summary.
AI_API_KEY=your_gemini_api_key
AI_VISION_MODEL=gemini-2.5-flash

